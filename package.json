{
  "name": "typefully-eve-template",
  "version": "0.0.0",
  "private": true,
  "description": "A Slack-based social media agent built on eve that drafts, schedules, and manages posts across X, LinkedIn, Threads, Bluesky, and Mastodon through Typefully.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/typefully-eve-template.git"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "dev": "eve dev",
    "fix": "ultracite fix",
    "start": "eve start",
    "typecheck": "tsc",
    "validate": "pnpm run check && pnpm run typecheck && eve info"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0",
    "@vercel/connect": "0.6.1",
    "ai": "^7.0.58",
    "eve": "^0.31.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "~24.13.3",
    "typescript": "7.0.2",
    "ultracite": "^7.10.2"
  },
  "engines": {
    "node": "24.x"
  }
}
