{
  "name": "typefully-eve-template",
  "version": "0.0.0",
  "private": true,
  "description": "A Slack-based social media agent built on eve that drafts, schedules, and manages posts across X, LinkedIn, Threads, Bluesky, and Mastodon through Typefully.",
  "repository": {
    "type": "git",
    "url": "https://github.com/vercel-labs/typefully-eve-template.git"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./agent/*"
  },
  "scripts": {
    "build": "eve build",
    "check": "ultracite check",
    "dev": "eve dev",
    "fix": "ultracite fix",
    "start": "eve start",
    "typecheck": "tsc",
    "validate": "pnpm run check && pnpm run typecheck && eve info"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/connect": "2.5.5",
    "ai": "^7.0.150",
    "eve": "^0.83.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.5.15",
    "@types/node": "~24.19.2",
    "typescript": "7.0.2",
    "ultracite": "^8.0.1"
  },
  "engines": {
    "node": "24.x"
  }
}
